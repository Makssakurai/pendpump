{
  "expo": {
    "name": "Vendpump",
    "slug": "vendpump",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "vendpump",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#2A5BD7"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#F0F6FF"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A5BD7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "themeColor": "#2A5BD7",
      "backgroundColor": "#F0F6FF"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
